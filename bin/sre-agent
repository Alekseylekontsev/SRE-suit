#!/bin/sh
# Local convenience wrapper: run the containerized SRE Agent as `./bin/sre-agent <cmd>`.
#
#   ./bin/sre-agent health
#   ./bin/sre-agent monitor
#   ./bin/sre-agent status --node srv1 --vmid 100
#
# Requires: the image built (`docker compose build`) and a ./config.yaml present.
# Runs hardened (read-only rootfs, no-new-privileges, dropped caps) with the
# config mounted read-only and a persistent data volume for the secret store/audit.
#
# Networking: defaults to Docker's bridge network. To monitor services on an
# internal VLAN that the bridge can't route to (e.g. LiteLLM on an internal IP),
# opt into host networking:
#
#   SRE_NETWORK=host ./bin/sre-agent monitor
#
# Host networking removes container network isolation — use it only when you
# actually need to reach internal-only targets.
#
# Secrets source (recommended for teams): instead of a local config.yaml, fetch
# the config from a shared Bitwarden org Collection at run time, so rotation is
# done in ONE place and every laptop picks it up automatically — no stale creds.
#
#   bw login && export BW_SESSION="$(bw unlock --raw)"   # once per session, as yourself
#   SRE_BW_ITEM="SRE Agent config" ./bin/sre-agent monitor
#
# The fetched config lives only in a private temp file for the duration of the
# run and is deleted afterwards — nothing persists on the laptop.
set -eu

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"

TMP_CONFIG=""
cleanup() { [ -n "$TMP_CONFIG" ] && rm -f "$TMP_CONFIG"; }
trap cleanup EXIT INT TERM

if [ -n "${SRE_BW_ITEM:-}" ]; then
    command -v bw >/dev/null 2>&1 || { echo "bw (Bitwarden CLI) not installed" >&2; exit 1; }
    bw unlock --check >/dev/null 2>&1 || { echo "Bitwarden vault locked — run: export BW_SESSION=\"\$(bw unlock --raw)\"" >&2; exit 1; }
    TMP_CONFIG="$(mktemp -t sre-agent-config.XXXXXX)"
    chmod 600 "$TMP_CONFIG"
    # Secure note holding the agent's config.yaml = single source of truth.
    if ! bw get notes "$SRE_BW_ITEM" > "$TMP_CONFIG" 2>/dev/null || [ ! -s "$TMP_CONFIG" ]; then
        echo "could not fetch Bitwarden item '$SRE_BW_ITEM' (check name + Collection access)" >&2
        exit 1
    fi
    CONFIG="$TMP_CONFIG"
else
    CONFIG="${SRE_CONFIG:-$REPO_DIR/config.yaml}"
    if [ ! -f "$CONFIG" ]; then
        echo "config not found at $CONFIG — set SRE_BW_ITEM to fetch from Bitwarden, or copy sre_agent/config/profiles/config.example.yaml (ask an SRE for real values)" >&2
        exit 1
    fi
fi

# Opt-in network override (e.g. SRE_NETWORK=host); empty -> default bridge.
NET_ARGS=""
if [ -n "${SRE_NETWORK:-}" ]; then
    NET_ARGS="--network ${SRE_NETWORK}"
fi

# Not exec'd, so the EXIT trap can delete the fetched config afterwards.
# shellcheck disable=SC2086  # intentional word-split of optional NET_ARGS
docker run --rm -i \
    $NET_ARGS \
    --read-only --security-opt no-new-privileges:true --cap-drop ALL \
    --tmpfs /tmp \
    -v "$CONFIG:/config/config.yaml:ro" \
    -v sre-agent-data:/var/lib/sre-agent \
    sre-agent:latest "$@"
